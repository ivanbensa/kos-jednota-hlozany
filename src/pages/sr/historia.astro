
---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Историја | КПД Једнота Гложан">
    <main class="min-h-screen bg-sky-50 py-16 px-4">
        <div class="mx-auto max-w-5xl">
            <h1 class="mb-8 text-center text-4xl font-bold text-[#102A43]">
                Историја нашег друштва
            </h1>

            <p class="mx-auto max-w-3xl text-center text-lg leading-relaxed text-slate-700">
                На овој страници ћемо вам ускоро представити историју
                нашег културно-уметничког друштва КПД Једнота Гложан.
            </p>
        </div>
    </main>
</Layout>
