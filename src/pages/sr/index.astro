---
import Layout from '../../layouts/Layout.astro';
import { getTranslations } from '../../i18n';

const t = getTranslations('sr');
---

<Layout title={t.hero.title}>
    <main class="min-h-screen bg-sky-50 px-6 py-24 text-center">
        <h1 class="text-4xl font-bold text-sky-900">
            {t.hero.title}
        </h1>

        <p class="mt-6 text-xl text-slate-700">
            {t.hero.subtitle}
        </p>
    </main>
</Layout>