---
import Layout from '../../layouts/Layout.astro';
import { news } from '../../data/news';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

const sortedNews = [...news].sort((a, b) =>
    b.date.localeCompare(a.date)
);
---

<Layout>
    <main class="min-h-screen bg-sky-50 px-4 py-16 sm:px-6 lg:px-8">
        <div class="mx-auto max-w-6xl">

            <h1 class="mb-4 text-center text-4xl font-bold text-[#102A43]">
                Všetky novinky
            </h1>

            <p class="mb-12 text-center text-slate-600">
                Najnovšie správy a udalosti z nášho spolku.
            </p>

            <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
                {sortedNews.map((item) => (
                        <article class="overflow-hidden rounded-2xl border border-sky-200 bg-white shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-lg">

                            <img
                                    src={`${base}${item.image.replace(/^\/+/, '')}`}
                                    alt={item.title}
                                    class="h-56 w-full object-cover"
                                    loading="lazy"
                            />

                            <div class="p-6">
                                <time datetime={item.date} class="text-sm text-slate-500">
                                    {new Intl.DateTimeFormat('sk-SK', {
                                        day: 'numeric',
                                        month: 'long',
                                        year: 'numeric',
                                    }).format(new Date(`${item.date}T12:00:00Z`))}
                                </time>

                                <h2 class="mt-3 mb-3 text-xl font-bold text-[#102A43]">
                                    {item.title}
                                </h2>

                                <p class="mb-6 text-slate-600">
                                    {item.description}
                                </p>

                                <a
                                        href={`${base}novinky/${item.slug}`}
                                        class="font-semibold text-[#1B79AC] hover:underline"
                                >
                                    Čítať viac →
                                </a>
                            </div>
                        </article>
                ))}
            </div>

        </div>
    </main>
</Layout>
