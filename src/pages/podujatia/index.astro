---
import Layout from '../../layouts/Layout.astro';
import { events } from '../../data/events';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

const sortedEvents = [...events].sort((a, b) =>
    a.date.localeCompare(b.date)
);

const formatDate = (date: string) =>
    new Intl.DateTimeFormat('sk-SK', {
        day: 'numeric',
        month: 'long',
        year: 'numeric',
        timeZone: 'UTC',
    }).format(new Date(`${date}T12:00:00Z`));
---

<Layout>
    <main class="min-h-screen bg-[#D9EDF8] px-4 py-16 sm:px-6 lg:px-8">
        <div class="mx-auto max-w-6xl">

            <h1 class="mb-4 text-center text-4xl font-bold text-[#102A43]">
                Všetky podujatia
            </h1>

            <p class="mb-12 text-center text-slate-600">
                Vystúpenia a podujatia nášho spolku.
            </p>

            <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
                {sortedEvents.map((event) => (
                        <article class="flex flex-col overflow-hidden rounded-2xl border border-sky-200 bg-[#EDF7FC] shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-lg">

                            <img
                                    src={`${base}${event.image.replace(/^\/+/, '')}`}
                                    alt={event.title}
                                    class="h-56 w-full object-cover"
                                    loading="lazy"
                            />

                            <div class="flex flex-1 flex-col p-6">
                                <time
                                        datetime={event.date}
                                        class="text-sm font-semibold text-[#1B79AC]"
                                >
                                    {formatDate(event.date)} · {event.time}
                                </time>

                                <h2 class="mt-3 mb-3 text-xl font-bold text-[#102A43]">
                                    {event.title}
                                </h2>

                                <p class="mb-3 text-sm text-slate-500">
                                    📍 {event.location}
                                </p>

                                <p class="mb-6 text-slate-600">
                                    {event.description}
                                </p>

                                <a
                                        href={`${base}podujatia/${event.slug}`}
                                        class="mt-auto font-semibold text-[#1B79AC] hover:underline"
                                >
                                    Viac informácií →
                                </a>
                            </div>
                        </article>
                ))}
            </div>

        </div>
    </main>
</Layout>