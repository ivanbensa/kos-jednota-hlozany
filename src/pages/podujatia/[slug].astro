
---
import Layout from '../../layouts/Layout.astro';
import { events } from '../../data/events';
import type { EventItem } from '../../types/events';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

export function getStaticPaths() {
    return events.map((event) => ({
        params: { slug: event.slug },
        props: { event },
    }));
}

const { event } = Astro.props as { event: EventItem };

const date = new Date(`${event.date}T12:00:00Z`);

const formattedDate = new Intl.DateTimeFormat('sk-SK', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
    timeZone: 'UTC',
}).format(date);
---

<Layout>
    <main class="min-h-screen bg-[#D9EDF8] py-10 sm:py-14 md:py-20 lg:py-24">
        <article class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">

            <!-- Povratak na događaje -->
            <a
                    href={`${base}#podujatia`}
                    class="mb-8 inline-flex items-center gap-2
                       text-sm font-semibold text-primary
                       transition-colors hover:text-dark
                       sm:mb-10 sm:text-base"
            >
                <span aria-hidden="true">←</span>
                Späť na podujatia
            </a>

            <!-- Datum -->
            <time
                    datetime={event.date}
                    class="mb-3 block text-xs font-bold uppercase
                       tracking-[0.15em] text-primary
                       sm:mb-4 sm:text-sm"
            >
                {formattedDate}
            </time>

            <!-- Naslov -->
            <h1
                    class="mb-7 text-3xl font-bold leading-tight
                       tracking-tight text-dark
                       sm:mb-9 sm:text-4xl
                       lg:mb-10 lg:text-5xl"
            >
                {event.title}
            </h1>

            <!-- Glavna fotografija -->
            <div
                    class="mb-8 overflow-hidden rounded-xl bg-sky-100
                       shadow-md sm:mb-10 sm:rounded-2xl"
            >
                <img
                        src={`${base}${event.image.replace(/^\/+/, '')}`}
                        alt={event.title}
                        class="aspect-[4/3] w-full object-cover
                           sm:aspect-[16/10]
                           lg:aspect-[16/9]"
                />
            </div>

            <!-- Informacije o događaju -->
            <div
                    class="mb-10 grid grid-cols-1 gap-4 rounded-2xl
           border border-sky-200 bg-[#EDF7FC] p-5
           shadow-sm sm:grid-cols-3 sm:gap-6 sm:p-7"
            >
                <!-- Datum -->
                <div class="flex items-start gap-3">
                    <span class="text-xl" aria-hidden="true">📅</span>

                    <div>
                        <p class="mb-1 text-xs font-semibold uppercase tracking-wider text-primary">
                            Dátum
                        </p>

                        <p class="font-semibold text-dark">
                            {formattedDate}
                        </p>
                    </div>
                </div>

                <!-- Vreme -->
                <div class="flex items-start gap-3">
                    <span class="text-xl" aria-hidden="true">🕒</span>

                    <div>
                        <p class="mb-1 text-xs font-semibold uppercase tracking-wider text-primary">
                            Čas
                        </p>

                        <p class="font-semibold text-dark">
                            {event.time}
                        </p>
                    </div>
                </div>

                <!-- Lokacija -->
                <div class="flex items-start gap-3">
                    <span class="text-xl" aria-hidden="true">📍</span>

                    <div>
                        <p class="mb-1 text-xs font-semibold uppercase tracking-wider text-primary">
                            Miesto
                        </p>

                        <p class="font-semibold text-dark">
                            {event.location}
                        </p>
                    </div>
                </div>
            </div>

            <!-- Uvod -->
            <p
                    class="mb-8 text-lg font-medium leading-8 text-slate-700
                       sm:text-xl sm:leading-9"
            >
                {event.description}
            </p>

            <!-- Kompletan opis -->
            <div class="space-y-5 sm:space-y-6">
                {event.content.map((paragraph) => (
                        <p
                                class="text-base leading-8 text-slate-700
                               sm:text-lg sm:leading-9"
                        >
                            {paragraph}
                        </p>
                ))}
            </div>

            <!-- Donja navigacija -->
            <div
                    class="mt-12 border-t border-sky-300 pt-8
                       sm:mt-16"
            >
                <a
                        href={`${base}#podujatia`}
                        class="inline-flex items-center gap-2
                           text-sm font-semibold text-primary
                           transition-colors hover:text-dark
                           sm:text-base"
                >
                    <span aria-hidden="true">←</span>
                    Späť na podujatia
                </a>
            </div>

        </article>
    </main>
</Layout>
