---
import Layout from '../layouts/Layout.astro';

---

<Layout>
    <main class="min-h-screen bg-sky-50 py-16 px-4">
        <div class="mx-auto max-w-5xl">
            <h1 class="mb-8 text-center text-4xl font-bold text-[#102A43]">
                História nášho spolku
            </h1>

            <p class="mx-auto max-w-3xl text-center text-lg leading-relaxed text-slate-700">
                Na tejto stránke vám čoskoro predstavíme históriu
                nášho kultúrno-umeleckého spolku KOS Jednota Hložany.
            </p>
        </div>
    </main>
</Layout>