
---
import { events, eventsSr } from '../data/events';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const lang = Astro.currentLocale === 'sr' ? 'sr' : 'sk';

const labels = {
    sk: {
        eyebrow: 'Život nášho spolku',
        title: 'Archív podujatí',
        description: 'Všetky naše vystúpenia, stretnutia a kultúrne podujatia na jednom mieste.',
        moreInfo: 'Viac informácií',
        noEvents: 'Zatiaľ nemáme žiadne podujatia.',
    },
    sr: {
        eyebrow: 'Живот нашег друштва',
        title: 'Архива дешавања',
        description: 'Сви наши наступи, окупљања и културни догађаји на једном месту.',
        moreInfo: 'Више информација',
        noEvents: 'За сада немамо објављених дешавања.',
    },
};

const t = labels[lang];

const allEvents = [...(lang === 'sr' ? eventsSr : events)]
    .sort((a, b) => b.date.localeCompare(a.date));

const eventUrl = (slug: string) =>
    lang === 'sr'
        ? `${base}sr/podujatia/${slug}`
        : `${base}podujatia/${slug}`;

const formatMonth = (date: Date) =>
    new Intl.DateTimeFormat(lang === 'sr' ? 'sr-RS' : 'sk-SK', {
        month: 'short',
        timeZone: 'UTC',
    }).format(date);
---

<main class="min-h-screen bg-[#D9EDF8] py-14 sm:py-20 lg:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">

        <!-- Naslov arhive -->
        <div class="mb-12 text-center sm:mb-16">

            <p
                    class="mb-4 text-xs font-bold uppercase
                       tracking-[0.2em] text-primary sm:text-sm"
            >
                {t.eyebrow}
            </p>

            <h1
                    class="mb-5 text-4xl font-bold
                       tracking-tight text-dark sm:text-5xl"
            >
                {t.title}
            </h1>

            <p
                    class="mx-auto max-w-2xl text-base
                       leading-8 text-slate-700 sm:text-lg"
            >
                {t.description}
            </p>
        </div>

        <!-- Sva dešavanja -->
        <div class="space-y-4 sm:space-y-5">

            {allEvents.length > 0 ? (
                allEvents.map((event) => {

                    const date = new Date(`${event.date}T12:00:00Z`);

                    return (
                            <article
                                    class="group overflow-hidden rounded-2xl
                                   border border-sky-200 bg-[#EDF7FC]
                                   shadow-sm transition-all duration-300
                                   hover:-translate-y-1 hover:shadow-lg"
                            >
                                <div
                                        class="flex flex-col gap-5 p-5
                                       sm:p-6
                                       md:flex-row md:items-center md:gap-6
                                       lg:gap-8 lg:p-7"
                                >

                                    <!-- Datum -->
                                    <div
                                            class="flex h-20 w-20 shrink-0 flex-col
                                           items-center justify-center rounded-xl
                                           bg-primary text-white
                                           sm:h-24 sm:w-24"
                                    >
                                    <span
                                            class="text-3xl font-bold leading-none
                                               sm:text-4xl"
                                    >
                                        {date.getUTCDate()}
                                    </span>

                                        <span
                                                class="mt-1 text-xs font-semibold uppercase
                                               sm:text-sm"
                                        >
                                        {formatMonth(date)}
                                    </span>

                                        <span class="text-xs font-medium">
                                        {date.getUTCFullYear()}
                                    </span>
                                    </div>

                                    <!-- Tekst događaja -->
                                    <div class="min-w-0 flex-1">

                                        <h2
                                                class="mb-2 text-xl font-bold leading-snug
                                               text-dark sm:text-2xl"
                                        >
                                            {event.title}
                                        </h2>

                                        <p
                                                class="mb-4 text-sm leading-7
                                               text-slate-600 sm:text-base"
                                        >
                                            {event.description}
                                        </p>

                                        <div
                                                class="flex flex-col gap-2 text-sm
                                               font-medium text-primary
                                               sm:flex-row sm:flex-wrap sm:gap-x-5"
                                        >
                                        <span class="inline-flex items-start gap-2">
                                            <span aria-hidden="true">📍</span>
                                            {event.location}
                                        </span>

                                            <span class="inline-flex items-center gap-2">
                                            <span aria-hidden="true">🕒</span>
                                                {event.time}
                                        </span>
                                        </div>

                                    </div>

                                    <!-- Fotografija -->
                                    <div
                                            class="h-44 w-full shrink-0 overflow-hidden
                                           rounded-xl bg-sky-100
                                           sm:h-48
                                           md:h-28 md:w-36
                                           lg:h-32 lg:w-44"
                                    >
                                        <img
                                                src={`${base}${event.image.replace(/^\/+/, '')}`}
                                                alt={event.title}
                                                loading="lazy"
                                                class="h-full w-full object-cover
                                               transition-transform duration-500
                                               group-hover:scale-105"
                                        />
                                    </div>

                                    <!-- Dugme -->
                                    <a
                                            href={eventUrl(event.slug)}
                                            class="inline-flex w-full shrink-0 items-center
                                           justify-center gap-2 rounded-lg
                                           border-2 border-primary px-5 py-3
                                           text-sm font-semibold text-primary
                                           transition-colors
                                           hover:bg-primary hover:text-white
                                           sm:w-fit md:px-4 lg:px-5"
                                    >
                                        {t.moreInfo}
                                        <span aria-hidden="true">→</span>
                                    </a>

                                </div>
                            </article>
                    );
                })
            ) : (
                    <p
                            class="rounded-2xl border border-sky-100 bg-white
                           px-5 py-10 text-center text-slate-600 shadow-sm"
                    >
                        {t.noEvents}
                    </p>
            )}

        </div>

    </div>
</main>
