
---
import { news, newsSr } from '../data/news.ts';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const lang = Astro.currentLocale === 'sr' ? 'sr' : 'sk';

const labels = {
    sk: {
        eyebrow: 'Život nášho spolku',
        title: 'Archív noviniek',
        description: 'Všetky správy, udalosti a príbehy zo života nášho spolku na jednom mieste.',
        readMore: 'Čítať viac',
    },
    sr: {
        eyebrow: 'Живот нашег друштва',
        title: 'Архива вести',
        description: 'Све вести, догађаји и приче из живота нашег друштва на једном месту.',
        readMore: 'Прочитај више',
    },
};

const t = labels[lang];

const allNews = [...(lang === 'sr' ? newsSr : news)]
    .sort((a, b) => b.date.localeCompare(a.date));

const articleUrl = (slug: string) =>
    lang === 'sr'
        ? `${base}sr/novinky/${slug}`
        : `${base}novinky/${slug}`;

const formatDate = (date: string) =>
    new Intl.DateTimeFormat(lang === 'sr' ? 'sr-RS' : 'sk-SK', {
        day: 'numeric',
        month: 'long',
        year: 'numeric',
        timeZone: 'UTC',
    }).format(new Date(`${date}T12:00:00Z`));
---

<main class="min-h-screen bg-sky-50 py-14 sm:py-20 lg:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">

        <!-- Naslov arhive -->
        <div class="mb-12 text-center sm:mb-16">
            <p class="mb-4 text-sm font-bold uppercase tracking-[0.2em] text-primary">
                {t.eyebrow}
            </p>

            <h1 class="mb-5 text-4xl font-bold tracking-tight text-dark sm:text-5xl">
                {t.title}
            </h1>

            <p class="mx-auto max-w-2xl text-base leading-8 text-slate-600 sm:text-lg">
                {t.description}
            </p>
        </div>

        <!-- Sve vesti -->
        <div class="grid grid-cols-1 gap-6 md:grid-cols-2 md:gap-7 lg:grid-cols-3 lg:gap-8">

            {allNews.map((item) => (
                    <article
                            class="group flex h-full flex-col overflow-hidden
                           rounded-2xl border border-sky-100 bg-white
                           shadow-sm transition-all duration-300
                           hover:-translate-y-1 hover:shadow-xl"
                    >
                        <a
                                href={articleUrl(item.slug)}
                                class="block h-52 overflow-hidden bg-sky-100 sm:h-64 md:h-56 lg:h-60"
                        >
                            <img
                                    src={`${base}${item.image.replace(/^\/+/, '')}`}
                                    alt={item.title}
                                    loading="lazy"
                                    class="h-full w-full object-cover
                                   transition-transform duration-500
                                   group-hover:scale-105"
                            />
                        </a>

                        <div class="flex flex-1 flex-col p-5 sm:p-6 lg:p-7">

                            <time
                                    datetime={item.date}
                                    class="text-xs font-semibold text-primary sm:text-sm"
                            >
                                {formatDate(item.date)}
                            </time>

                            <h2 class="mt-3 mb-3 text-xl font-bold leading-snug text-dark sm:text-2xl">
                                <a
                                        href={articleUrl(item.slug)}
                                        class="transition-colors hover:text-primary"
                                >
                                    {item.title}
                                </a>
                            </h2>

                            <p class="mb-6 line-clamp-3 text-sm leading-7 text-slate-600 sm:text-base">
                                {item.description}
                            </p>

                            <a
                                    href={articleUrl(item.slug)}
                                    class="mt-auto inline-flex w-fit items-center gap-2
                                   text-sm font-bold text-primary
                                   transition-all hover:gap-3 hover:text-dark"
                            >
                                {t.readMore}
                                <span aria-hidden="true">→</span>
                            </a>

                        </div>
                    </article>
            ))}

        </div>
    </div>
</main>
