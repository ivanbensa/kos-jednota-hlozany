---
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<section id="o-nas" class="bg-cream py-24">
    <div class="mx-auto grid max-w-7xl items-center gap-14 px-6 lg:grid-cols-2">

        <!-- Tekst -->
        <div>
            <p class="mb-4 text-sm font-semibold uppercase tracking-[0.25em] text-primary">
                Kto sme
            </p>

            <h2 class="mb-6 text-4xl font-bold text-dark md:text-5xl">
                Naše tradície.<br />
                Naša hrdosť.
            </h2>

            <p class="mb-5 text-lg leading-8 text-gray-700">
                KOS Jednota Hložany je kultúrno-umelecký spolok,
                ktorý sa venuje zachovávaniu slovenského folklóru,
                ľudových tancov, hudby a tradícií.
            </p>

            <p class="mb-8 leading-8 text-gray-600">
                Prostredníctvom našich folklórnych skupín spájame
                generácie a odovzdávame kultúrne dedičstvo mladším.
            </p>

            <a
                    href="/o-nas"
                    class="inline-flex items-center rounded-md bg-primary px-7 py-3 font-semibold text-white transition hover:brightness-110"
            >
                Viac o nás →
            </a>
        </div>

        <!-- Fotografija -->
        <div class="relative">
            <img
                    src={`${base}images/about.png`}
                    alt="Slovenský folklór v Hložanoch"
                    loading="lazy"
                    class="h-[450px] w-full rounded-xl object-cover shadow-xl"
            />

            <div class="pointer-events-none absolute -bottom-4 -left-4 -z-10 hidden h-32 w-32 rounded-xl border-4 border-[#D4AF37] lg:block"></div>
        </div>

    </div>
</section>