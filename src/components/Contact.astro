
---
const lang = Astro.currentLocale === 'sr' ? 'sr' : 'sk';
const email = 'kosjednotahlozany@gmail.com';
const phone = '064 106 0063';
const phoneLink = '+381641060063';

const labels = {
    sk: {
        eyebrow: 'Spojte sa s nami',
        title: 'Kontakt',
        description: 'Máte otázky alebo záujem o spoluprácu? Radi sa s vami spojíme.',
        society: 'KOS Jednota Hložany',
        locationLabel: 'Miesto',
        location: 'M. Tita 54, Hložany, Srbsko',
        emailLabel: 'E-mail',
        email: 'E-mail',
        phoneLabel: 'Telefón',
        phone: 'Telefón',
        heading: 'Buďte súčasťou našich tradícií',
        message: 'Máte záujem o folklór, vystúpenia alebo spoluprácu? Neváhajte nás kontaktovať.',
        note: 'Tešíme sa na vaše správy.',
    },
    sr: {
        eyebrow: 'Ступите у контакт са нама',
        title: 'Контакт',
        description: 'Имате питања или сте заинтересовани за сарадњу? Радо ћемо вам одговорити.',
        society: 'КПД Једнота Гложан',
        locationLabel: 'Место',
        location: 'М. Тита 54, Гложан, Србија',
        emailLabel: 'Е-пошта',
        email: 'Е-пошта',
        phoneLabel: 'Телефон',
        phone: 'Телефон',
        heading: 'Будите део наше традиције',
        message: 'Занимају вас фолклор, наступи или сарадња? Слободно нас контактирајте.',
        note: 'Радујемо се вашим порукама.',
    },
};

const t = labels[lang];
---

<section id="kontakt" class="bg-white py-24">
    <div class="mx-auto max-w-7xl px-6">

        <div class="mb-14 text-center">
            <p class="mb-4 text-sm font-semibold uppercase tracking-[0.25em] text-primary">
                {t.eyebrow}
            </p>

            <h2 class="mb-5 text-4xl font-bold text-dark md:text-5xl">
                {t.title}
            </h2>

            <p class="mx-auto max-w-2xl text-lg text-gray-600">
                {t.description}
            </p>
        </div>

        <div class="mx-auto grid max-w-5xl gap-8 md:grid-cols-2">

            <div class="rounded-2xl bg-cream p-10">
                <h3 class="mb-6 text-2xl font-bold text-dark">
                    {t.society}
                </h3>

                <div class="space-y-6 text-gray-700">
                    <div>
                        <p class="mb-1 font-semibold text-dark">
                            📍 {t.locationLabel}
                        </p>
                        <p>{t.location}</p>
                    </div>

                    <div>
                        <p class="mb-1 font-semibold text-dark">
                            ✉️ {t.emailLabel}
                        </p>
                        <p>{t.email}</p>
                    </div>

                    <div>
                        <p class="mb-1 font-semibold text-dark">
                            📞 {t.phoneLabel}
                        </p>
                        <p>{t.phone}</p>
                    </div>
                </div>
            </div>

            <div class="flex flex-col justify-center rounded-2xl bg-primary p-10 text-white">
                <h3 class="mb-5 text-3xl font-bold">
                    {t.heading}
                </h3>

                <p class="mb-8 leading-relaxed text-white/85">
                    {t.message}
                </p>

                <p class="text-sm text-white/80">
                    {t.note}
                </p>
            </div>

        </div>
    </div>
</section>
