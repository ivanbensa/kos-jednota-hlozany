---
const groups = [
    {
        title: 'Detská folklórna skupina',
        description: 'Naši najmladší objavujú krásu slovenských ľudových tancov, piesní a tradícií.',
        image: '/images/folklore-children.jpg',
    },
    {
        title: 'Mládežnícka folklórna skupina',
        description: 'Mladí tanečníci s nadšením rozvíjajú folklórne tradície a prezentujú ich na vystúpeniach.',
        image: '/images/folklore-youth.jpg',
    },
    {
        title: 'Folklórna skupina dospelých',
        description: 'Dospelí členovia uchovávajú a odovzdávajú bohatstvo slovenského folklóru ďalším generáciám.',
        image: '/images/folklore-adults.jpg',
    },
];
---

<section id="folklorne-sekcie" class="bg-white py-24">
    <div class="mx-auto max-w-7xl px-6">

        <!-- Naslov -->
        <div class="mb-14 text-center">
            <p class="mb-4 text-sm font-semibold uppercase tracking-[0.25em] text-primary">
                Naše skupiny
            </p>

            <h2 class="mb-5 text-4xl font-bold text-dark md:text-5xl">
                Folklór spája generácie
            </h2>

            <p class="mx-auto max-w-2xl text-lg leading-8 text-gray-600">
                Od najmenších tanečníkov až po dospelých.
                Spoločne zachovávame naše tradície.
            </p>
        </div>

        <!-- Kartice -->
        <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
            {groups.map((group) => (
                    <article class="group overflow-hidden rounded-xl bg-cream shadow-sm transition-all duration-300 hover:-translate-y-2 hover:shadow-xl">

                        <div class="h-72 overflow-hidden">
                            <img
                                    src={group.image}
                                    alt={group.title}
                                    loading="lazy"
                                    class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                            />
                        </div>

                        <div class="p-8">
                            <h3 class="mb-4 text-2xl font-bold text-dark">
                                {group.title}
                            </h3>

                            <p class="mb-7 leading-7 text-gray-600">
                                {group.description}
                            </p>

                            <a
                                    href="/folklorne-sekcie"
                                    class="inline-flex items-center gap-2 font-semibold text-primary transition hover:gap-4"
                            >
                                Zistiť viac <span aria-hidden="true">→</span>
                            </a>
                        </div>

                    </article>
            ))}
        </div>

    </div>
</section>