
---
import { about } from '../data/about';

const lang = Astro.currentLocale === 'sr' ? 'sr' : 'sk';
const content = about[lang];
---

<section class="bg-cream py-16 md:py-24">
    <div class="mx-auto max-w-4xl px-6">

        <p class="mb-4 text-sm font-semibold uppercase tracking-[0.25em] text-primary">
            KOS Jednota
        </p>

        <h1 class="mb-10 text-3xl font-bold leading-tight text-dark md:text-5xl">
            {content.title}
        </h1>

        <div class="space-y-7">
            {content.paragraphs.map((paragraph) => (
                    <p class="text-base leading-8 text-gray-700 md:text-lg md:leading-9">
                        {paragraph}
                    </p>
            ))}
        </div>

    </div>
</section>
