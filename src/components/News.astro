
---
import { news } from '../data/news.ts';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

const latestNews = [...news]
    .sort((a, b) => b.date.localeCompare(a.date))
    .slice(0, 3);

const formatDate = (date: string) =>
    new Intl.DateTimeFormat('sk-SK', {
        day: 'numeric',
        month: 'long',
        year: 'numeric',
        timeZone: 'UTC',
    }).format(new Date(`${date}T12:00:00Z`));
---

<section
        id="novinky"
        class="bg-sky-50 py-14 sm:py-18 md:py-20 lg:py-24"
>
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">

        <!-- Section heading -->
        <div
                class="mb-9 flex flex-col gap-5
                   sm:mb-12 sm:gap-6
                   md:flex-row md:items-end md:justify-between"
        >
            <div>
                <p
                        class="mb-3 text-xs font-bold uppercase
                           tracking-[0.2em] text-primary
                           sm:mb-4 sm:text-sm sm:tracking-[0.25em]"
                >
                    Život nášho spolku
                </p>

                <h2
                        class="text-3xl font-bold tracking-tight text-dark
                           sm:text-4xl lg:text-5xl"
                >
                    Najnovšie správy
                </h2>
            </div>

            <a
                    href={`${base}novinky`}
                    class="inline-flex w-fit items-center gap-2
                       text-sm font-semibold text-primary
                       transition-colors hover:text-dark
                       sm:text-base"
            >
                Všetky novinky
                <span aria-hidden="true">→</span>
            </a>
        </div>

        <!-- News cards -->
        <div
                class="grid grid-cols-1 gap-6
                   md:grid-cols-2 md:gap-7
                   lg:grid-cols-3 lg:gap-8"
        >
            {latestNews.map((item) => (
                    <article
                            class="group flex h-full flex-col overflow-hidden
                           rounded-2xl border border-sky-100 bg-white
                           shadow-sm transition-all duration-300
                           hover:-translate-y-1 hover:shadow-xl
                           md:hover:-translate-y-2"
                    >
                        <!-- Image -->
                        <a
                                href={`${base}novinky/${item.slug}`}
                                class="block h-52 overflow-hidden bg-sky-100
                               sm:h-64 md:h-56 lg:h-60"
                                aria-label={`Čítať: ${item.title}`}
                        >
                            <img
                                    src={`${base}${item.image.replace(/^\/+/, '')}`}
                                    alt={item.title}
                                    loading="lazy"
                                    class="h-full w-full object-cover
                                   transition-transform duration-500
                                   group-hover:scale-105"
                            />
                        </a>

                        <!-- Card content -->
                        <div
                                class="flex flex-1 flex-col p-5
                               sm:p-6 lg:p-7"
                        >
                            <time
                                    datetime={item.date}
                                    class="text-xs font-semibold text-primary
                                   sm:text-sm"
                            >
                                {formatDate(item.date)}
                            </time>

                            <h3
                                    class="mt-3 mb-3 text-xl font-bold
                                   leading-snug text-dark
                                   sm:text-2xl"
                            >
                                <a
                                        href={`${base}novinky/${item.slug}`}
                                        class="transition-colors hover:text-primary"
                                >
                                    {item.title}
                                </a>
                            </h3>

                            <p
                                    class="mb-6 line-clamp-3 text-sm leading-7
                                   text-slate-600 sm:text-base"
                            >
                                {item.description}
                            </p>

                            <a
                                    href={`${base}novinky/${item.slug}`}
                                    class="mt-auto inline-flex w-fit items-center
                                   gap-2 text-sm font-bold text-primary
                                   transition-all hover:gap-3
                                   hover:text-dark sm:text-base"
                            >
                                Čítať viac
                                <span aria-hidden="true">→</span>
                            </a>
                        </div>
                    </article>
            ))}
        </div>

    </div>
</section>

