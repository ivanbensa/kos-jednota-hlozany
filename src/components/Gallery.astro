
---
import 'photoswipe/style.css';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

const photos = [
    {
        src: `${base}images/Golden-Hour-Folk-Dance-Festival.png`,
        alt: 'Folklórne vystúpenie',
        width: 1920,
        height: 1080,
    },
    {
        src: `${base}images/about.png`,
        alt: 'Naše tradície',
        width: 1536,
        height: 1024,
    },
    {
        src: `${base}images/folklore-children.jpg`,
        alt: 'Detská folklórna skupina',
        width: 640,
        height: 1024,
    },
    {
        src: `${base}images/folklore-youth.jpg`,
        alt: 'Mládežnícka folklórna skupina',
        width: 640,
        height: 1024,
    },
    {
        src: `${base}images/folklore-adults.jpg`,
        alt: 'Folklórna skupina dospelých',
        width: 640,
        height: 1024,
    },
];
---

<section id="galeria" class="min-h-screen bg-sky-50 py-12 sm:py-16 md:py-20 lg:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">

        <!-- Naslov galerije -->
        <div class="mx-auto mb-10 max-w-3xl text-center sm:mb-12 lg:mb-14">
            <p
                    class="mb-3 text-xs font-bold uppercase tracking-[0.2em]
                       text-primary sm:mb-4 sm:text-sm sm:tracking-[0.25em]"
            >
                Naše spomienky
            </p>

            <h1
                    class="mb-5 text-3xl font-bold tracking-tight text-dark
                       sm:text-4xl lg:text-5xl"
            >
                Galéria
            </h1>

            <p
                    class="mx-auto max-w-2xl text-base leading-7 text-slate-600
                       sm:text-lg sm:leading-8"
            >
                Zachytené okamihy z našich vystúpení, skúšok a spoločných zážitkov.
            </p>
        </div>

        <!-- Fotografije -->
        <div
                id="photo-gallery"
                class="grid grid-cols-2 gap-3
                   sm:gap-4
                   md:grid-cols-3 md:gap-5
                   lg:gap-6"
        >
            {photos.map((photo, index) => (
                    <a
                            href={photo.src}
                            data-pswp-width={photo.width}
                            data-pswp-height={photo.height}
                            target="_blank"
                            rel="noopener"
                            aria-label={`Otvoriť fotografiu: ${photo.alt}`}
                            class:list={[
                                'group relative block overflow-hidden rounded-xl bg-sky-100 shadow-sm transition-shadow duration-300 hover:shadow-lg sm:rounded-2xl',
                                index === 0 ? 'col-span-2 row-span-2' : '',
                            ]}
                    >
                        <img
                                src={photo.src}
                                alt={photo.alt}
                                loading="lazy"
                                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                        />

                        <div
                                class="pointer-events-none absolute inset-0 bg-black/0
                               transition-colors duration-300 group-hover:bg-black/20"
                        ></div>
                    </a>
            ))}
        </div>

    </div>
</section>

<script>
    import PhotoSwipeLightbox from 'photoswipe/lightbox';

    const lightbox = new PhotoSwipeLightbox({
        gallery: '#photo-gallery',
        children: 'a',
        pswpModule: () => import('photoswipe'),
    });

    lightbox.init();
</script>
