---
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<section class="relative flex min-h-[calc(100vh-80px)] items-center justify-center overflow-hidden bg-slate-900 text-white">

    <img
            src={`${base}images/Golden-Hour-Folk-Dance-Festival.png`}
            alt="Folklórny súbor KOS Jednota Hložany"
            class="absolute inset-0 h-full w-full object-cover"
    />

    <div class="absolute inset-0 bg-black/55"></div>

    <div class="relative z-10 mx-auto max-w-5xl px-6 text-center">
        <p class="mb-5 text-sm font-semibold uppercase tracking-[0.3em] text-sky-300">
            Slovenská kultúra a tradície
        </p>

        <h1 class="mb-6 text-5xl font-bold md:text-7xl">
            KOS Jednota Hložany
        </h1>

        <p class="mb-9 text-xl text-gray-200 md:text-2xl">
            Zachovávame tradície pre ďalšie generácie.
        </p>

        <a
                href={`${base}o-nas`}
                class="inline-block rounded-md bg-primary px-8 py-4 font-semibold text-white transition-all duration-300 hover:bg-[#15618A] hover:scale-105"
        >
            Spoznajte nás
        </a>
    </div>

</section>