
---
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<section
        class="relative flex min-h-[calc(100svh-80px)] items-center justify-center overflow-hidden bg-slate-900 text-white lg:min-h-[calc(100vh-105px)]"
>
    <!-- Pozadinska fotografija -->
    <img
            src={`${base}images/Golden-Hour-Folk-Dance-Festival.png`}
            alt="Folklórny súbor KOS Jednota Hložany"
            class="absolute inset-0 h-full w-full object-cover object-center"
    />

    <!-- Tamni overlay za čitljivost teksta -->
    <div class="absolute inset-0 bg-black/55"></div>

    <!-- Hero sadržaj -->
    <div class="relative z-10 mx-auto w-full max-w-5xl px-5 py-16 text-center sm:px-8">

        <p
                class="mb-4 text-xs font-semibold uppercase tracking-[0.2em] text-sky-300 sm:mb-5 sm:text-sm sm:tracking-[0.3em]"
        >
            Slovenská kultúra a tradície
        </p>

        <h1
                class="mb-5 text-4xl leading-tight font-bold sm:text-5xl md:text-6xl lg:mb-6 lg:text-7xl"
        >
            KOS Jednota Hložany
        </h1>

        <p
                class="mx-auto mb-8 max-w-2xl text-base leading-relaxed text-gray-200 sm:text-lg md:text-xl lg:mb-9 lg:text-2xl"
        >
            Zachovávame tradície pre ďalšie generácie.
        </p>

        <a
                href={`${base}o-nas`}
                class="inline-block rounded-md bg-primary px-7 py-3.5 text-sm font-semibold text-white transition-all duration-300 hover:scale-105 hover:bg-[#15618A] sm:px-8 sm:py-4 sm:text-base"
        >
            Spoznajte nás
        </a>

    </div>
</section>
